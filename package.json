{
  "name": "cf-outlook-email",
  "version": "2.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/76hvc/cf-outlook-email.git"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node tools/build-schema.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "deploy": "wrangler deploy",
    "deploy:cf": "node tools/cf-deploy.mjs",
    "db:migrate": "wrangler d1 migrations apply outlook-email-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply outlook-email-db --local",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.18.0"
  }
}
