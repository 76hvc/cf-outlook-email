# Headers for the static SPA (served by the assets binding, so the Worker's
# secureHeaders middleware never sees these requests).
# Keep in sync with the CSP in src/index.ts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Asset filenames carry no content hash, so a long max-age means a browser keeps
# executing the PREVIOUS app.js for the whole TTL after every deploy — the UI
# silently stays on old code while the Worker behind it is already updated.
# no-cache forces revalidation (ETag makes it a cheap 304) so a deploy is live
# on the next page load. Add a content hash first if you ever want a long TTL.
/assets/*
  Cache-Control: no-cache
